# Copy to .env.local, fill in from your LiveKit Cloud project (Settings > Keys), then `source .env.local`.
export LIVEKIT_URL=wss://your-project.livekit.cloud
export LIVEKIT_API_KEY=
export LIVEKIT_API_SECRET=

# Optional MCP servers in apps/agent/mcp.json. A server is skipped until all of its variables are set.
# In Docker, docker-compose.yml sets GRAFANA_URL and OPENSEARCH_URL to Astronomy Shop's services.
# For `pnpm dev` on the host, run `uv tool install mcp-grafana opensearch-mcp-server-py` once and point them at the shop's published ports:
# Grafana via the shop's proxy (anonymous access, no token needed)
export GRAFANA_URL=http://localhost:8080/grafana
# OpenSearch's host port is random; this looks up the current one
export OPENSEARCH_URL=http://localhost:$(docker port opensearch 9200 | head -1 | cut -d: -f2)
# Axiom (remote, https://mcp.axiom.co/mcp)
export AXIOM_PAT=
export AXIOM_ORG_ID=
