{
  "mcpServers": {
    "grafana": {
      "command": "mcp-grafana",
      "args": ["--disable-write"],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}"
      }
    },
    "opensearch": {
      "command": "opensearch-mcp-server-py",
      "env": {
        "OPENSEARCH_URL": "${OPENSEARCH_URL}",
        "OPENSEARCH_NO_AUTH": "true"
      }
    },
    "axiom": {
      "url": "https://mcp.axiom.co/mcp",
      "headers": {
        "Authorization": "Bearer ${AXIOM_PAT}",
        "x-axiom-org-id": "${AXIOM_ORG_ID}"
      }
    }
  }
}
